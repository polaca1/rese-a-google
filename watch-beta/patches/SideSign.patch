+++ b/Sources/DeveloperPortal/WatchBeta.swift
@@ -0,0 +1,35 @@
+import Foundation
+
+public extension DeveloperPortal {
+    /// Experimental: reuse an existing App ID. Never creates App IDs or certificates.
+    /// Explicit user action may register the paired Watch as a development device.
+    func prepareWatchBetaProfile(watchIdentifier: String, bundleIdentifier: String,
+                                 team: Team, session: Session) async throws -> ProvisioningProfile {
+        try Task.checkCancellation()
+        // Fetch the user's existing iOS App IDs first; these are shared by the legacy Watch service.
+        // Abort before any device registration if the installed SideStore ID cannot be found.
+        let apps: ListAppIDsResponse = try await sendRequest(
+            url: Constants.URLs.listAppIDs, session: session, team: team)
+        guard let app = (apps.appIds ?? []).first(where: { $0.bundleIdentifier == bundleIdentifier }),
+              !app.identifier.isEmpty else {
+            throw ServerError.badServerResponse(reason: "Existing SideStore App ID not found; no App ID was created", jsonPayload: "")
+        }
+        try Task.checkCancellation()
+        let platform: [String: any Sendable] = ["DTDK_Platform": "watchos"]
+        let devices: ListDevicesResponse = try await sendRequest(
+            url: Constants.URLs.listDevices, additionalParameters: platform, session: session, team: team)
+        if !(devices.devices ?? []).contains(where: { $0.identifier == watchIdentifier }) {
+            try Task.checkCancellation()
+            let _: DeviceResponse = try await sendRequest(url: Constants.URLs.addDevice,
+                additionalParameters: ["DTDK_Platform": "watchos", "deviceNumber": watchIdentifier, "name": "Watch Beta"],
+                session: session, team: team)
+        }
+        try Task.checkCancellation()
+        let response: ProfileResponse = try await sendRequest(url: Constants.URLs.downloadProvisioningProfile,
+            additionalParameters: ["DTDK_Platform": "watchos", "appIdId": app.identifier], session: session, team: team)
+        guard let profile = try response.provisioningProfile?.toProvisioningProfile() else {
+            throw ServerError.badServerResponse(reason: "Missing Watch profile", jsonPayload: "")
+        }
+        return profile
+    }
+}
