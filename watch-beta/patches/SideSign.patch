+import Foundation
+
+/// Contains only fixed categories and numeric codes, never Apple's raw response.
+public struct WatchBetaProfileFailure: Error, Sendable {
+    public enum Operation: String, Sendable {
+        case listAppIDs, listDevices, registerDevice, downloadProfile, decodeProfile
+    }
+    public enum Kind: String, Sendable {
+        case appleAPI, network, invalidResponse, existingAppIDMissing, missingProfile, unknown
+    }
+    public let operation: Operation
+    public let kind: Kind
+    public let code: Int?
+}
+
+private func watchBetaStep<T>(_ operation: WatchBetaProfileFailure.Operation,
+                              action: () async throws -> T) async throws -> T {
+    do { return try await action() }
+    catch is CancellationError { throw CancellationError() }
+    catch let failure as WatchBetaProfileFailure { throw failure }
+    catch let error as URLError {
+        throw WatchBetaProfileFailure(operation: operation, kind: .network, code: error.errorCode)
+    }
+    catch let error as ServerError {
+        if case .underlyingError(let code, _) = error {
+            throw WatchBetaProfileFailure(operation: operation, kind: .appleAPI, code: code)
+        }
+        throw WatchBetaProfileFailure(operation: operation, kind: .invalidResponse, code: nil)
+    }
+    catch { throw WatchBetaProfileFailure(operation: operation, kind: .unknown, code: nil) }
+}
+
+public extension DeveloperPortal {
+    /// Experimental: reuse an existing App ID. Never creates App IDs or certificates.
+    /// Explicit user action may register the paired Watch as a development device.
+    func prepareWatchBetaProfile(watchIdentifier: String, bundleIdentifier: String,
+                                 team: Team, session: Session) async throws -> ProvisioningProfile {
+        try Task.checkCancellation()
+        let apps: ListAppIDsResponse = try await watchBetaStep(.listAppIDs) {
+            try await sendRequest(url: Constants.URLs.listAppIDs, session: session, team: team)
+        }
+        // A signed SideStore bundle can carry a team suffix while the portal
+        // retains the original App ID. Match only an existing, unique ID.
+        let existing = apps.appIds ?? []
+        let exact = existing.filter { $0.bundleIdentifier == bundleIdentifier && !$0.identifier.isEmpty }
+        let suffix = "." + team.identifier
+        let unsuffixed = bundleIdentifier.hasSuffix(suffix)
+            ? String(bundleIdentifier.dropLast(suffix.count)) : bundleIdentifier
+        let matches = exact.isEmpty
+            ? existing.filter { $0.bundleIdentifier == unsuffixed && !$0.identifier.isEmpty }
+            : exact
+        guard matches.count == 1, let app = matches.first else {
+            throw WatchBetaProfileFailure(operation: .listAppIDs, kind: .existingAppIDMissing, code: nil)
+        }
+        try Task.checkCancellation()
+        let platform: [String: any Sendable] = ["DTDK_Platform": "watchos"]
+        let devices: ListDevicesResponse = try await watchBetaStep(.listDevices) {
+            try await sendRequest(url: Constants.URLs.listDevices, additionalParameters: platform,
+                                  session: session, team: team)
+        }
+        if !(devices.devices ?? []).contains(where: { $0.identifier == watchIdentifier }) {
+            try Task.checkCancellation()
+            let _: DeviceResponse = try await watchBetaStep(.registerDevice) {
+                try await sendRequest(url: Constants.URLs.addDevice,
+                    additionalParameters: ["DTDK_Platform": "watchos", "deviceNumber": watchIdentifier, "name": "Watch Beta"],
+                    session: session, team: team)
+            }
+        }
+        try Task.checkCancellation()
+        let response: ProfileResponse = try await watchBetaStep(.downloadProfile) {
+            try await sendRequest(url: Constants.URLs.downloadProvisioningProfile,
+                additionalParameters: ["DTDK_Platform": "watchos", "appIdId": app.identifier], session: session, team: team)
+        }
+        return try await watchBetaStep(.decodeProfile) {
+            guard let profile = try response.provisioningProfile?.toProvisioningProfile() else {
+                throw WatchBetaProfileFailure(operation: .decodeProfile, kind: .missingProfile, code: nil)
+            }
+            return profile
+        }
+    }
+}
