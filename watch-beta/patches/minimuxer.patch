diff --git a/DeviceGateway/idevice/IdeviceGateway.swift b/DeviceGateway/idevice/IdeviceGateway.swift
index e9310d0..524771c 100644
--- a/DeviceGateway/idevice/IdeviceGateway.swift
+++ b/DeviceGateway/idevice/IdeviceGateway.swift
@@ -2299,6 +2299,48 @@ extension IdeviceGateway {
         }
     }
 
+    public func fetchPairedWatchIdentifiers() async throws -> [String] {
+        try await withFFIDispatch {
+            try self.verifyInitialized()
+            return try self.performWithEitherService(
+                connectRP: companion_proxy_connect_rsd,
+                connectLockdown: companion_proxy_connect,
+                cleanup: companion_proxy_client_free,
+                serviceName: "companion_proxy"
+            ) { client in
+                var entries: UnsafeMutablePointer<UnsafeMutablePointer<CChar>?>? = nil
+                var count: UInt = 0
+                if let error = companion_proxy_get_device_registry(client, &entries, &count) {
+                    defer { self.safeFreeError(error) }
+                    // Never log or surface the library's raw message: it can contain identifiers.
+                    throw IdeviceGatewayError(.serviceError, reason: "Apple Watch registry request failed")
+                }
+                guard let entries else {
+                    guard count == 0 else { throw IdeviceGatewayError(.serviceError, reason: "Invalid Watch registry") }
+                    return []
+                }
+                defer {
+                    for index in 0..<Int(count) { if let entry = entries[index] { idevice_string_free(entry) } }
+                    idevice_outer_slice_free(entries, count)
+                }
+                guard count <= 32 else {
+                    throw IdeviceGatewayError(.serviceError, reason: "Unexpected Watch registry size")
+                }
+                var identifiers = Set<String>()
+                for index in 0..<Int(count) {
+                    guard let value = entries[index] else { continue }
+                    let identifier = String(cString: value)
+                    guard !identifier.isEmpty, identifier.utf8.count <= 128,
+                          identifier.unicodeScalars.allSatisfy({ CharacterSet.alphanumerics.contains($0) || $0 == "-" }) else {
+                        throw IdeviceGatewayError(.serviceError, reason: "Invalid Watch identifier")
+                    }
+                    identifiers.insert(identifier)
+                }
+                return identifiers.sorted()
+            }
+        }
+    }
